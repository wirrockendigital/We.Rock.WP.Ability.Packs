  "code-snippets/validate-code": {
    "label": "Validate Code",
    "description": "Parse PHP and run native identifier checks without executing code. Does not prove runtime safety; HTML/CSS/JavaScript require separate review.",
    "category": "code-snippets",
    "input_schema": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 100000
        },
        "scope": {
          "type": "string",
          "enum": [
            "global",
            "admin",
            "front-end",
            "content",
            "head-content",
            "body-content",
            "footer-content",
            "admin-css",
            "site-css",
            "site-head-js",
            "site-footer-js"
          ]
        }
      },
      "required": [
        "code",
        "scope"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": true,
      "destructive": false,
      "idempotent": true
    }
  },
  "code-snippets/create-snippet": {
    "label": "Create Snippet",
    "description": "Create an inactive local snippet. Preview by default. Uses a fresh catalog revision to reject stale retries.",
    "category": "code-snippets",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Fresh snippet revision, or catalog_revision for creation. Re-read after any uncertain outcome."
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "changes": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 10000
            },
            "code": {
              "type": "string",
              "maxLength": 100000
            },
            "scope": {
              "type": "string",
              "enum": [
                "global",
                "admin",
                "front-end",
                "content",
                "head-content",
                "body-content",
                "footer-content",
                "admin-css",
                "site-css",
                "site-head-js",
                "site-footer-js"
              ]
            },
            "priority": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            "tags": {
              "type": "array",
              "maxItems": 30,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "required": [
            "name",
            "code",
            "scope"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "changes"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": false
    }
  },
