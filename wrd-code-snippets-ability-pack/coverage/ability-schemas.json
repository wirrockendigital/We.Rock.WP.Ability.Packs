  "code-snippets/activate-snippet": {
    "label": "Activate Snippet",
    "description": "Activate a local snippet with revision checking. Preview by default; trash requires inactive state. Restore leaves the snippet inactive.",
    "category": "code-snippets",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Fresh snippet revision, or catalog_revision for creation. Re-read after any uncertain outcome."
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "acknowledge_execution": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly acknowledge that activation enables code execution on subsequent requests and native hooks."
        }
      },
      "required": [
        "id",
        "expected_revision",
        "reason"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
