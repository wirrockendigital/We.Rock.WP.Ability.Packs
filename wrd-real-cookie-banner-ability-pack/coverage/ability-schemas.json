  "real-cookie-banner/create-draft": {
    "label": "Create Draft",
    "category": "real-cookie-banner",
    "description": "Create a service or blocker draft through native WordPress operations. Preview by default; published items are protected. Restore accepts only former drafts.",
    "input_schema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service",
            "blocker"
          ]
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Fresh item revision; use catalog_revision from list-items for creation."
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "changes": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "type": "string",
                  "maxLength": 20000
                },
                "groups": {
                  "type": "array",
                  "maxItems": 30,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "meta": {
                  "type": "object",
                  "properties": {
                    "isProviderCurrentWebsite": {
                      "type": "boolean"
                    },
                    "provider": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "providerContactPhone": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "providerContactEmail": {
                      "type": "string",
                      "maxLength": 254
                    },
                    "providerContactLink": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "uniqueName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[a-zA-Z0-9_-]+$"
                    },
                    "providerPrivacyPolicyUrl": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "providerLegalNoticeUrl": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "codeOptIn": {
                      "type": "string",
                      "maxLength": 100000
                    },
                    "codeOptOut": {
                      "type": "string",
                      "maxLength": 100000
                    },
                    "codeOnPageLoad": {
                      "type": "string",
                      "maxLength": 100000
                    },
                    "executePriority": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 999
                    }
                  },
                  "required": [],
                  "additionalProperties": false,
                  "minProperties": 1
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": false,
              "minProperties": 1
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "type": "string",
                  "maxLength": 20000
                },
                "service_ids": {
                  "type": "array",
                  "maxItems": 30,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "meta": {
                  "type": "object",
                  "properties": {
                    "rules": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "isVisual": {
                      "type": "boolean"
                    },
                    "isVisualDarkMode": {
                      "type": "boolean"
                    },
                    "visualBlur": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "visualHeroButtonText": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "shouldForceToShowVisual": {
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "additionalProperties": false,
                  "minProperties": 1
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": false,
              "minProperties": 1
            }
          ]
        }
      },
      "required": [
        "kind",
        "expected_revision",
        "reason",
        "changes"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": false
    }
  },
