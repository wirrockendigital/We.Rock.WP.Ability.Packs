  "wpvivid-imgoptim-free/get-settings-schema": {
    "label": "Discover writable settings",
    "description": "Return exact types and limits accepted by update-settings.",
    "category": "wpvivid-imgoptim-free",
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
