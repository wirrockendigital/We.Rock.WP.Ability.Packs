  "wpvivid-imgoptim-free/update-settings": {
    "label": "Patch supported settings",
    "description": "Preview a minimal settings delta. Explicit dry_run false writes only this site using a revision check and InnoDB row lock. Unknown and credential-bearing settings are rejected. Current site optimization settings for future work; saving does not optimize existing images.",
    "category": "wpvivid-imgoptim-free",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Revision from a fresh get-settings response."
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Operator rationale; never include secrets. Not written to the audit summary."
        },
        "dry_run": {
          "type": "boolean",
          "default": true,
          "description": "Preview unless explicitly false."
        },
        "changes": {
          "type": "object",
          "properties": {
            "quality": {
              "type": "string",
              "description": "Compression mode used for future optimization.",
              "enum": [
                "lossless",
                "lossy"
              ]
            },
            "keep_exif": {
              "type": "boolean",
              "description": "Keep EXIF metadata during future image optimization."
            },
            "backup": {
              "type": "boolean",
              "description": "Keep original image backups during future optimization."
            },
            "only_resize": {
              "type": "boolean",
              "description": "Resize images without compression during future operations."
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "changes"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": true
    }
  },
  "wpvivid-imgoptim-free/list-cron-events": {
    "label": "Inspect WPvivid cron events",
    "description": "List shared WPvivid cron timestamps without arguments or executing callbacks.",
    "category": "wpvivid-imgoptim-free",
    "input_schema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25,
          "description": "Maximum returned records."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0,
          "description": "Records skipped in deterministic order."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false
