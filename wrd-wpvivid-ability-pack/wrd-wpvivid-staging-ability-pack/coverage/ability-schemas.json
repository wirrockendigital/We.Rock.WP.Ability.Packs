  "wpvivid-staging/get-settings-schema": {
    "label": "Discover writable settings",
    "description": "Return exact types and limits accepted by update-settings.",
    "category": "wpvivid-staging",
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
