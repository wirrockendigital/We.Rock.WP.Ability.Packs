  "wpvivid-backup/start-local-backup": {
    "label": "Start a local backup",
    "description": "Preview by default. With dry_run false and acknowledge_retention true, prepare and queue a native manual local backup. Native retention may delete old unlocked backups. Requires a UUID v4 request_id reused across retries. A preparing or schedule_failed receipt requires reconciliation, not a new request. Poll list-tasks and list-backups for completion.",
    "category": "wpvivid-backup",
    "input_schema": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "enum": [
            "files+db",
            "db",
            "files"
          ],
          "default": "files+db",
          "description": "Native backup content selection."
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
          "description": "UUID v4 unique to this logical request; reuse on retries."
        },
        "dry_run": {
          "type": "boolean",
          "default": true,
          "description": "Preview unless explicitly false."
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Operator rationale; never include secrets. Not written to the audit summary."
        },
        "acknowledge_retention": {
          "type": "boolean",
          "default": false,
          "description": "Explicit acknowledgment that native retention can delete old unlocked backups. Required true for execution."
        }
      },
      "required": [
        "request_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": false
    }
  }
}
