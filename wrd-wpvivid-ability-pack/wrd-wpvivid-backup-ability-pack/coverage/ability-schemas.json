  "wpvivid-backup/update-settings": {
    "label": "Patch supported settings",
    "description": "Preview a minimal settings delta. Explicit dry_run false writes only this site using a revision check and InnoDB row lock. Unknown and credential-bearing settings are rejected. Current site backup runtime settings; no retention changes.",
    "category": "wpvivid-backup",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Revision from a fresh get-settings response."
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Operator rationale; never include secrets. Not written to the audit summary."
        },
        "dry_run": {
          "type": "boolean",
          "default": true,
          "description": "Preview unless explicitly false."
        },
        "changes": {
          "type": "object",
          "properties": {
            "max_execution_time": {
              "type": "integer",
              "description": "Maximum execution time in seconds for future backup tasks.",
              "minimum": 30,
              "maximum": 900
            },
            "max_resume_count": {
              "type": "integer",
              "description": "Maximum retries for future backup tasks.",
              "minimum": 0,
              "maximum": 12
            },
            "compress_file_count": {
              "type": "integer",
              "description": "Files per compression batch for future tasks.",
              "minimum": 10,
              "maximum": 5000
            },
            "max_file_size": {
              "type": "integer",
              "description": "Archive split size in MiB for future backups.",
              "minimum": 10,
              "maximum": 1024
            },
            "max_sql_file_size": {
              "type": "integer",
              "description": "SQL split size in MiB for future backups.",
              "minimum": 10,
              "maximum": 1024
            },
            "show_admin_bar": {
              "type": "boolean",
              "description": "Show the WPvivid shortcut in the administration toolbar."
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "changes"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": true
    }
  },
  "wpvivid-backup/list-cron-events": {
    "label": "Inspect WPvivid cron events",
    "description": "List shared WPvivid cron timestamps without arguments or executing callbacks.",
    "category": "wpvivid-backup",
    "input_schema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25,
          "description": "Maximum returned records."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0,
          "description": "Records skipped in deterministic order."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readonly": true,
      "destructive": false,
      "idempotent": true
    }
  },
