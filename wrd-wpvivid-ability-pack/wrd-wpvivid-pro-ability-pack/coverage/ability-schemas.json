  "wpvivid-pro/get-settings-schema": {
    "label": "Discover writable settings",
    "description": "Return exact types and limits accepted by update-settings.",
    "category": "wpvivid-pro",
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
