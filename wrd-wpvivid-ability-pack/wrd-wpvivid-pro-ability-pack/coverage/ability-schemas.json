  "wpvivid-pro/update-settings": {
    "label": "Patch supported settings",
    "description": "Preview a minimal settings delta. Explicit dry_run false writes only this site using a revision check and InnoDB row lock. Unknown and credential-bearing settings are rejected. Current site Pro settings; retain_local controls retention after future remote uploads.",
    "category": "wpvivid-pro",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Revision from a fresh get-settings response."
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Operator rationale; never include secrets. Not written to the audit summary."
        },
        "dry_run": {
          "type": "boolean",
          "default": true,
          "description": "Preview unless explicitly false."
        },
        "changes": {
          "type": "object",
          "properties": {
            "retain_local": {
              "type": "boolean",
              "description": "Retain a local copy after a future remote backup upload."
            },
            "hide_admin_update_notice": {
              "type": "boolean",
              "description": "Hide the WPvivid Pro update notice."
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "changes"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": true
    }
  },
  "wpvivid-pro/list-cron-events": {
    "label": "Inspect WPvivid cron events",
    "description": "List shared WPvivid cron timestamps without arguments or executing callbacks.",
    "category": "wpvivid-pro",
    "input_schema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25,
          "description": "Maximum returned records."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0,
          "description": "Records skipped in deterministic order."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readonly": true,
      "destructive": false,
      "idempotent": true
    }
  },
