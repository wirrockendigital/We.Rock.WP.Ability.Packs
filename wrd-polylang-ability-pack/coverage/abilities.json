        "kind": {
          "type": "string",
          "enum": [
            "post",
            "term"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "translation_id": {
          "type": "integer",
          "minimum": 1
        },
        "translation_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "kind",
        "id",
        "translation_id",
        "translation_revision"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
