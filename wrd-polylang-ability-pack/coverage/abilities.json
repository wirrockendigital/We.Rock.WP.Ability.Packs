  "polylang/translate-string": {
    "name": "polylang/translate-string",
    "label": "Translate String",
    "description": "Translate one registered string by its ID from list-strings. Preserves other translations and applies native sanitization. Empty translation removes this translation and restores source fallback.",
    "category": "polylang",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
