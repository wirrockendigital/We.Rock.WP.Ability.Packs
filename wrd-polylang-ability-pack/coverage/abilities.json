      "idempotent": true
    }
  },
  "polylang/update-setting": {
    "name": "polylang/update-setting",
    "label": "Update Setting",
    "description": "Change one supported setting via native validation and save hooks. Get schemas from get-settings. URL host/domain mode and raw menu maps are excluded. Preview validates without executing hooks.",
    "category": "polylang",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "name": {
          "type": "string",
          "enum": [
            "default_lang",
            "hide_default",
            "rewrite",
            "redirect_lang",
            "browser",
            "media_support",
            "post_types",
            "taxonomies",
            "sync"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 100
              }
            }
          ]
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": true
    }
  },
  "polylang/list-content": {
    "name": "polylang/list-content",
    "label": "List Content",
    "description": "Find translated post types or taxonomies with their current language and translation links. Returns metadata only. Use get-content for a writable revision.",
