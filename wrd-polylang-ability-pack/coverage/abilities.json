  "polylang/link-translation": {
    "name": "polylang/link-translation",
    "label": "Link Translation",
    "description": "Link an existing same-type object in another language to the source group. Preserves other translations; rejects occupied language slots and foreign groups. Requires fresh revisions for both objects.",
    "category": "polylang",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
