  "polylang/create-language": {
    "name": "polylang/create-language",
    "label": "Create Language",
    "description": "Add a language through the native controller. Does not create a default category. The first language becomes default. Preview checks schema and uniqueness; lifecycle hooks run only on execution.",
    "category": "polylang",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:_[A-Za-z0-9]+)*$",
          "maxLength": 40
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "is_rtl": {
          "type": "boolean"
        },
        "term_group": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "flag_code": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{2,30}$"
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "locale",
        "slug",
        "name",
        "is_rtl"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": false
    }
  },
  "polylang/update-language": {
    "name": "polylang/update-language",
    "label": "Update Language",
    "description": "Change display name, direction, order or flag of a language. Supply only changed fields; slug and locale migrations are excluded.",
    "category": "polylang",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 32
        },
        "changes": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "is_rtl": {
              "type": "boolean"
            },
            "term_group": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "flag_code": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{2,30}$"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "language",
        "changes"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": true
    }
  },
