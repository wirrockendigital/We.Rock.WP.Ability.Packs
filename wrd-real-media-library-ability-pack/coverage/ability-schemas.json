  "real-media-library/move-attachments": {
    "label": "Move Attachments",
    "category": "real-media-library",
    "description": "Move up to 50 existing original media assignments into a regular folder or unorganized root. Native validation remains enabled; disk paths and URLs are unchanged by this pack.",
    "input_schema": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Fresh whole-library revision from a read; re-read after any uncertain outcome."
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "folder_id": {
          "type": "integer",
          "minimum": -1,
          "not": {
            "enum": [
              0
            ]
          },
          "description": "Native folder ID; -1 is unorganized/root."
        },
        "attachment_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "folder_id",
        "attachment_ids"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": true
    }
  },
