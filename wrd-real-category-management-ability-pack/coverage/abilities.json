          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "term_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "post_type",
        "taxonomy",
        "expected_revision",
        "reason",
        "term_id"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
