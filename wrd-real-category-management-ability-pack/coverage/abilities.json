    }
  },
  "real-category-management/get-assignments": {
    "name": "real-category-management/get-assignments",
    "label": "Get Assignments",
    "description": "Read taxonomy assignments of up to 50 individually editable posts/pages and the revision needed for assign-posts.",
    "category": "real-category-management",
    "input_schema": {
      "type": "object",
      "properties": {
        "post_type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "taxonomy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "post_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "post_type",
        "taxonomy",
        "post_ids"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": true,
      "destructive": false,
      "idempotent": true
    }
  },
  "real-category-management/assign-posts": {
    "name": "real-category-management/assign-posts",
    "label": "Assign Posts",
    "description": "Move posts to one category (replace this taxonomy only) or copy (append category without duplicating content). target_id=0 removes assignments; WordPress may restore its default category. Get expected_revision from get-assignments using the same post_ids.",
    "category": "real-category-management",
    "input_schema": {
      "type": "object",
      "properties": {
        "post_type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "taxonomy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "post_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "target_id": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": [
            "move",
            "copy"
          ]
        }
      },
      "required": [
        "post_type",
        "taxonomy",
        "expected_revision",
        "reason",
        "post_ids",
        "target_id",
        "mode"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": true
    }
  },
