  "real-category-management/get-tree": {
    "name": "real-category-management/get-tree",
    "label": "Get Tree",
    "description": "Read the native category tree plus complete term metadata and a tree revision. Does not remember a UI selection.",
    "category": "real-category-management",
    "input_schema": {
      "type": "object",
      "properties": {
        "post_type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "taxonomy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        }
      },
      "required": [
        "post_type",
        "taxonomy"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": true,
      "destructive": false,
      "idempotent": true
    }
  },
  "real-category-management/create-term": {
    "name": "real-category-management/create-term",
    "label": "Create Term",
    "description": "Create one category through the native plugin controller. Get expected_revision from get-tree. Parent defaults to root.",
    "category": "real-category-management",
    "input_schema": {
      "type": "object",
      "properties": {
        "post_type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "taxonomy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "parent": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "post_type",
        "taxonomy",
        "expected_revision",
        "reason",
        "name"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": false
    }
  },
  "real-category-management/rename-term": {
    "name": "real-category-management/rename-term",
    "label": "Rename Term",
    "description": "Rename a category through the native plugin controller. Native behavior also changes its slug and therefore may change archive URLs.",
    "category": "real-category-management",
    "input_schema": {
      "type": "object",
      "properties": {
        "post_type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "taxonomy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "term_id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "post_type",
        "taxonomy",
        "expected_revision",
        "reason",
        "term_id",
        "name"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": true
    }
  },
  "real-category-management/relocate-term": {
    "name": "real-category-management/relocate-term",
    "label": "Relocate Term",
    "description": "Move a category to parent (0=root), before before_id (0=end), through native ordering. Rejects cycles and invalid siblings. Get expected_revision from get-tree.",
    "category": "real-category-management",
    "input_schema": {
      "type": "object",
      "properties": {
        "post_type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "taxonomy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "term_id": {
          "type": "integer",
          "minimum": 1
        },
        "parent": {
          "type": "integer",
          "minimum": 0
        },
        "before_id": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "post_type",
        "taxonomy",
        "expected_revision",
        "reason",
        "term_id",
        "parent",
        "before_id"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readonly": false,
      "destructive": true,
      "idempotent": true
    }
  },
